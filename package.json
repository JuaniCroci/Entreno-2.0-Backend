{
  "name": "entreno-2-0-backend",
  "version": "0.1.0",
  "description": "Backend e-commerce Entreno 2.0 — API REST (Express 5 + MikroORM + MySQL 8)",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:watch": "vitest",
    "migrate": "tsx ./node_modules/@mikro-orm/cli/cli.js migration:up",
    "migrate:dev": "tsx ./node_modules/@mikro-orm/cli/cli.js migration:create && tsx ./node_modules/@mikro-orm/cli/cli.js migration:up",
    "migrate:test": "tsx ./node_modules/@mikro-orm/cli/cli.js migration:up --env test",
    "schema:dev": "tsx ./node_modules/@mikro-orm/cli/cli.js schema:create --fresh",
    "seed:admin": "tsx scripts/seedAdmin.ts"
  },
  "dependencies": {
    "@mikro-orm/core": "^6.4.15",
    "@mikro-orm/migrations": "^6.4.15",
    "@mikro-orm/mysql": "^6.4.15",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "mysql2": "^3.12.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "@mikro-orm/cli": "^6.6.16",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.3.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0"
}
