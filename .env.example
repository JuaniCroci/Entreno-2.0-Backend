# Ambiente
NODE_ENV=development
PORT=3000

# MySQL (coincide con docker-compose.yml; 3307 evita chocar con un MySQL local en 3306)
DB_HOST=localhost
DB_PORT=3307
DB_USER=entreno
DB_PASSWORD=entreno
DB_NAME=entreno

# Auth (se usa desde feature 002)
JWT_SECRET=reemplaza_con_un_secret_fuerte
BCRYPT_ROUNDS=10

# CORS hacia el frontend (Vite en dev)
CORS_ORIGIN=http://localhost:5173

# Seed de admin (feature 002)
ADMIN_EMAIL=admin@entreno.com
ADMIN_PASSWORD=changeme_en_produccion
